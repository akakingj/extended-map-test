{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "mguHmi": [
      "ID7"
    ],
    "build": {
      "python": "kit/tools/build.py",
      "args": [
        "--language",
        "ko",
        "{id}"
      ],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "shared": [
        "kit/runtime",
        "kit/platform",
        "kit/localization",
        "kit/tools/build.py",
        "kit/tools/pack_data.py",
        "kit/tools/localize.py",
        "kit/tools/locale-revisions.json",
        "kit/tools/oapgen",
        "kit/tools/make_icon.js",
        "oap-sdk"
      ],
      "network": []
    }
  },
  "components": [
    {
      "id": "waze-on-cluster",
      "kind": "tool",
      "path": "native/waze-on-cluster"
    },
    {
      "id": "robertn_waze_cluster",
      "kind": "app",
      "path": "robert/robertn_waze_cluster",
      "build": "unit",
      "title": "Maps on cluster (extended map test)",
      "requires": {
        "waze-on-cluster": "0.10.7"
      },
      "uninstallable": true,
      "mguHmi": [
        "ID7"
      ]
    }
  ]
}
